{
  "version": 2,
  "builds": [
    { "src": "onboarding/server.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/data/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/data/$1"
    },
    { "src": "/(.*)", "dest": "onboarding/server.js" }
  ]
}
